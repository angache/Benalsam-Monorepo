# =============================================================================
# BENALSAM PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# Production-specific environment variables
# Copy this file to .env.production and fill in your production values
#
# WARNING: This file contains production settings
# Never commit actual production credentials to Git
#
# =============================================================================

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Environment
NODE_ENV=production
PORT=3002

# URLs (Production)
API_URL=https://admin.benalsam.com/api/v1
VITE_API_URL=https://admin.benalsam.com/api/v1
BASE_URL=https://admin.benalsam.com

# CORS (Production - Restrictive)
CORS_ORIGIN=https://admin.benalsam.com,https://benalsam.com

# Database (Production)
DATABASE_URL=postgresql://production_user:secure_password@production_host:5432/benalsam_prod

# Redis (Production)
REDIS_HOST=redis.production
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@redis.production:6379

# Elasticsearch (Production)
ELASTICSEARCH_URL=https://elasticsearch.production:9200
ELASTICSEARCH_INDEX=benalsam_listings_prod
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_secure_elasticsearch_password

# Logging (Production)
LOG_LEVEL=warn
LOG_FILENAME=logs/app-prod.log

# Security (Production - Strict)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# PRODUCTION SECURITY (STRICT)
# =============================================================================

# Production JWT (Secure)
JWT_SECRET=your-super-secure-production-jwt-secret-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Production Admin (Secure)
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password-here

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_HTTPS_REDIRECT=true

# =============================================================================
# PRODUCTION MONITORING
# =============================================================================

# Production Monitoring
ENABLE_PROD_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true
ENABLE_HEALTH_CHECKS=true

# Monitoring Services
SENTRY_DSN=your-production-sentry-dsn
LOG_AGGREGATION_URL=your-log-aggregation-url
METRICS_ENDPOINT=your-metrics-endpoint

# =============================================================================
# PRODUCTION PERFORMANCE
# =============================================================================

# Performance Settings
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_CDN=true
ENABLE_LOAD_BALANCING=true

# Database Performance
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Redis Performance
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECTION_TIMEOUT=5000

# =============================================================================
# PRODUCTION EXTERNAL SERVICES
# =============================================================================

# Production AI Services
EXPO_PUBLIC_OPENAI_API_KEY=your-production-openai-key
EXPO_PUBLIC_DEEPSEEK_API_KEY=your-production-deepseek-key
EXPO_PUBLIC_GEMINI_API_KEY=your-production-gemini-key

# Production Firebase
FIREBASE_PROJECT_ID=your-production-firebase-project
FIREBASE_APP_ID=your-production-firebase-app-id

# Production Email
EMAIL_HOST=smtp.production.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your-production-email
EMAIL_PASS=your-production-email-password
EMAIL_FROM=noreply@benalsam.com

# Production AWS
AWS_ACCESS_KEY_ID=your-production-aws-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret
AWS_REGION=eu-west-1
AWS_S3_BUCKET=benalsam-production-uploads

# Production Stripe
STRIPE_SECRET_KEY=sk_live_your-production-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret

# =============================================================================
# PRODUCTION BACKUP & RECOVERY
# =============================================================================

# Backup Settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Recovery Settings
ENABLE_DISASTER_RECOVERY=true
RECOVERY_TIME_OBJECTIVE=4h
RECOVERY_POINT_OBJECTIVE=1h

# =============================================================================
# PRODUCTION COMPLIANCE
# =============================================================================

# Compliance Settings
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_ENCRYPTION=true
ENABLE_ACCESS_CONTROL=true
ENABLE_COMPLIANCE_REPORTING=true

# GDPR Compliance
ENABLE_GDPR_COMPLIANCE=true
ENABLE_DATA_RETENTION_POLICY=true
ENABLE_USER_DATA_EXPORT=true

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# 
# This configuration is for production environments only
# All credentials must be secure and unique
# Enable all security features
# Monitor performance and errors
# Regular security audits required
# 
# ============================================================================= 