# =============================================================================
# BENALSAM DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# Development-specific environment variables
# Copy this file to .env.development and customize as needed
#
# =============================================================================

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Environment
NODE_ENV=development
PORT=3002

# URLs (Local Development)
API_URL=http://localhost:3002/api/v1
VITE_API_URL=http://localhost:3002/api/v1
BASE_URL=http://localhost:3002

# CORS (Local Development)
CORS_ORIGIN=http://localhost:3003,http://localhost:5173,http://localhost:3000

# Database (Local Development)
DATABASE_URL=postgresql://username:password@localhost:5432/benalsam_admin_dev

# Redis (Local Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Elasticsearch (Local Docker)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=benalsam_listings_dev

# Logging (Development)
LOG_LEVEL=debug
LOG_FILENAME=logs/app-dev.log

# Security (Development - Less Strict)
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# DEVELOPMENT FEATURES
# =============================================================================

# Enable Development Features
ENABLE_DEBUG_MODE=true
ENABLE_HOT_RELOAD=true
ENABLE_DEV_TOOLS=true

# Development Ports
ADMIN_BACKEND_PORT=3002
ADMIN_UI_PORT=3003
WEB_PORT=5173
MOBILE_DEV_PORT=8081

# =============================================================================
# DEVELOPMENT SECURITY (LESS STRICT)
# =============================================================================

# Development JWT (Less Secure for Development)
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Development Admin (Less Secure)
ADMIN_DEFAULT_PASSWORD=dev123456

# =============================================================================
# DEVELOPMENT MONITORING
# =============================================================================

# Development Monitoring
ENABLE_DEV_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_ERROR_TRACKING=false

# =============================================================================
# DEVELOPMENT EXTERNAL SERVICES
# =============================================================================

# Development AI Services (Optional)
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=

# Development Firebase (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 
# This configuration is for local development only
# Use .env.production for production environments
# Never commit actual credentials to Git
# 
# =============================================================================
